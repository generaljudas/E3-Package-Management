# E3 Package Manager Backend Configuration
# All values are optional — the defaults work out of the box.

# Server
PORT=3001
NODE_ENV=development
# Interface to listen on. Loopback by default: the API has no authentication
# and must not be exposed to the network. Only change this if you know why.
HOST=127.0.0.1

# CORS origin for the frontend dev server
FRONTEND_URL=http://localhost:5173

# SQLite database file. If relative, resolved from the backend directory.
# Use a dedicated file for testing to avoid touching real data.
DB_PATH=./database.sqlite

# Set to true to start with an empty database (skip demo seed data)
SKIP_SEED=false
