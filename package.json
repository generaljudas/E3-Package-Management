{
  "name": "e3-package-manager",
  "version": "1.0.0-beta.1",
  "description": "A comprehensive package inventory management system for mailbox renting centers. Built with a staff-first approach for speed, reliability, and keyboard-optimized workflows.",
  "main": "electron/main.js",
  "scripts": {
    "electron:dev": "electron .",
    "build:frontend": "cd frontend && npm run build",
    "preelectron:build": "npm run build:frontend",
    "electron:build": "electron-builder",
    "preelectron:build:all": "npm run build:frontend",
    "electron:build:all": "electron-builder --windows --mac --linux"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generaljudas/E3-Package-Management.git"
  },
  "keywords": [
    "package-management",
    "mailbox",
    "barcode-scanner",
    "inventory"
  ],
  "author": "Javier Ibarra <javieribarra.dev@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/generaljudas/E3-Package-Management/issues"
  },
  "homepage": "https://github.com/generaljudas/E3-Package-Management#readme",
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.e3.package-manager",
    "productName": "E3 Package Manager",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/src",
        "to": "backend/src"
      },
      {
        "from": "backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "E3 Package Manager"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office"
    }
  }
}
